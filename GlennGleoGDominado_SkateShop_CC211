  .hero-section { padding: 38px 0 48px; }.main-logo { width: 210px; }.hero-brand { margin-bottom: 8px; }.category-card { flex-basis: 36%; }.category-card img { height: 145px; }.section-pad { padding: 58px 0; }.about-image-frame img { height: 230px; }.product-image { height: 250px; }.product-info { align-items: flex-start; flex-direction: column; }.product-info .btn { width: 100%; }
}
@media (min-width: 768px) and (max-width: 991.98px) { .category-card { flex-basis: 30%; }.main-nav { gap: 13px; }.main-nav a { font-size: 10px; } }

